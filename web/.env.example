# Copie para .env.local e preencha com o SEU projeto Supabase.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key

# Ativa o app privado (zero-knowledge). Sem isso a UI cai no modo legacy.
VITE_SUCO_CONTROL=supabase

# 'preview' mostra o banner de ambiente de teste; use 'production' no deploy real.
VITE_SUCO_ENV=preview

# Allowlist do worker TEE: ID da conta (UUID do auth user) + URL e digest da imagem.
# Sem esses pins o canal fica 'unavailable' (fail closed).
VITE_SUCO_OWNER_WORKER_ID=
VITE_SUCO_OWNER_WORKER_URL=
VITE_SUCO_OWNER_WORKER_DIGEST=
VITE_SUCO_PARTNER_WORKER_ID=
VITE_SUCO_PARTNER_WORKER_URL=
VITE_SUCO_PARTNER_WORKER_DIGEST=

# Pins do atestado: projeto e zona GCP onde rodam as VMs Confidential Space.
# Sem eles nenhum token de atestado é aceito (fail closed).
VITE_SUCO_ATTESTATION_PROJECT_ID=
VITE_SUCO_ATTESTATION_ZONE=

# Origem HTTPS da API legado que o front pode conectar (ex. https://api.seu-dominio.exemplo).
# Sem esse pin o campo de conexão recusa qualquer URL (fail closed) e o modo
# legado não liga. Desenvolvimento local aceita http://127.0.0.1:<porta> sem pin.
VITE_SUCO_LEGACY_API_ORIGIN=
