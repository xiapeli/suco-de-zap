# Copie para backend/.env e preencha com os SEUS valores.
# Nunca comite .env — só este exemplo versionado.

# ===== Obrigatórios (modo legado / API própria) =====
# Token que o front legado envia como Authorization: Bearer <token>.
API_TOKEN=gere-um-token-longo-e-aleatorio
# SQLite do motor (arquivo local, criado automaticamente).
DATABASE_URL=file:./suco.db

# ===== Servidor =====
PORT=8377
# Bind default é 127.0.0.1 (loopback) — exponha só via túnel na mesma máquina.
# Setar 0.0.0.0 é uma escolha consciente e exige API_TOKEN forte.
# BIND_HOST=127.0.0.1

# ===== Cérebro dos sucos (escolha UMA das opções; sem LLM não gera digest) =====
# 1) Servidor OpenAI-compatível local (llama-server, LM Studio, vLLM...):
# OPENAI_COMPAT_URL=http://127.0.0.1:8080/v1
# OPENAI_COMPAT_MODEL=qwen
# Probe opcional de readiness (ex. http://127.0.0.1:8378/ready):
# LLM_READY_URL=
# 2) Anthropic (usado só quando OPENAI_COMPAT_URL está vazio):
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-opus-5

# ===== WhatsApp =====
# Diretório onde fica a sessão autenticada (gere com o QR na primeira execução).
WA_AUTH_DIR=./auth_state
# Proxy SOCKS se a sua rede bloquear o WhatsApp (ex.: socks5://127.0.0.1:1080):
# WA_PROXY=

# ===== Agendamentos e digest =====
SUCO_CRON=0 8 * * *
DIGEST_CRON=5 0 * * *
EXTRACT_CRON=*/30 * * * *
SUCO_MIN_MESSAGES=5
TZ_SUCO=Asia/Shanghai
# Contexto máximo enviado ao LLM (chars). Com LLM local o default é 60k.
# MAX_TRANSCRIPT_CHARS=60000

# ===== CORS =====
# Allowlist extra de origens (vírgula-separada). Vazio = default seguro.
# NUNCA use "*" em produção.
# CORS_ORIGINS=
# PUBLIC_DOMAIN=https://seu-dominio.exemplo

# ===== Só para o worker Confidential Space (não usado no modo legado) =====
# SUCO_GLM_REGULAR_KEY_FILE=/secrets/glm_regular_key
# SUCO_GLM_SECRET_RESOURCE=projects/SEU-PROJETO/secrets/SEU-SEGREDO/versions/latest
# SUCO_CHANNEL_ALLOWED_ORIGIN=https://app.seu-dominio.exemplo
